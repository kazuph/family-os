    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "~4.119.0"
  }
}
