{
  "name": "@gadgets/integration-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./harness": "./src/harness.ts",
    "./network-interceptor": "./src/network-interceptor.ts",
    "./rpc-client": "./src/rpc-client.ts"
  },
  "scripts": {
    "test:prebuild": "pnpm --filter @gadgets/workshop-backend build:integration-worker",
