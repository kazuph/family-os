{
  "name": "@gadgets/cloudflare-gatekeeper",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/cloudflare.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "vp run --no-cache build:configurator && wrangler deploy",
    "build": "tsc",
    "types:check": "tsc --noEmit",
    "test:run": "vitest run && vitest run -c vitest.worker.config.ts",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/configurator-ui": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "^0.8.0",
    "capnweb-validate": "0.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "miniflare": "5.20260801.0-alpha",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
