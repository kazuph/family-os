{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-context",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_irrevocable_stub_storage"
  ],

  // DO classes are reached via ctx.exports; no durable_objects binding needed.
  // Declarative exports (replaces the legacy imperative `migrations` array); each class
  // below has a live SQLite-backed namespace. `exports` and `migrations` are mutually
  // exclusive at the Wrangler config layer, so only one may be present.
  "exports": {
    "ContextCollectionDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "UserLibraryDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "LibraryRegistryDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "ContextGatekeeper": { "type": "durable-object", "storage": "sqlite" }
  },

  // Public-collections snapshot KV. preview_id preserves existing dev data.
  "kv_namespaces": [
    {
      "binding": "CONTEXT_COLLECTIONS",
      "preview_id": "gadgets-context-collections"
    }
  ],

  // Optional: add an Artifacts binding named ARTIFACTS to enable Git-backed collections.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

}
